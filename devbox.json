{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": {
    "uv": "latest",
    "ruff": "latest",
    "python": {
      "version": "3.12",
      "disable_plugin": true
    },
    "jq": "latest",
    "bat": "latest"
  },
  "shell": {
    "init_hook": [
      "uv sync",
      "source .venv/bin/activate"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ],
      "build": [ "python build/freeze.py" ]
    }
  }
}
